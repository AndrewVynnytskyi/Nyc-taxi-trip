# Copy to `.env` and fill in. `.env` is git-ignored and is loaded by the
# notebooks via python-dotenv and by Docker via `--env-file .env`.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nyc_taxi

# --- Paths ------------------------------------------------------------------
# Optional: skip the kagglehub download and point at a local CSV.
# NYC_TAXI_CSV_PATH=/absolute/path/to/yellow_tripdata_2015-01.csv
# NYC_TAXI_DATA_DIR=data
# NYC_TAXI_ARTIFACT_DIR=models
# Optional: cap the number of training rows for a fast smoke run.
# NYC_TAXI_ROW_LIMIT=200000

# --- Weights & Biases -------------------------------------------------------
WANDB_ENABLED=true
WANDB_MODE=online          # online | offline | disabled
WANDB_API_KEY=
# WANDB_ENTITY=your-team
